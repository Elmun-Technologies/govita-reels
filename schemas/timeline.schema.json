{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "timeline",
  "type": "object",
  "required": ["scenes", "cover"],
  "properties": {
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "shots"],
        "properties": {
          "id": {"type": "integer"},
          "shots": {"type": "array", "minItems": 1, "items": {
            "type": "object", "required": ["asset"],
            "properties": {
              "asset": {"type": "string"},
              "kind": {"enum": ["video", "photo"]},
              "media_start": {"type": "number", "minimum": 0},
              "motion": {"enum": ["zoom-in", "zoom-out", "pan-left", "pan-right", "pan-up", "punch-in", "none"]},
              "focus": {"enum": ["center", "top", "bottom"]},
              "weight": {"type": "number", "exclusiveMinimum": 0},
              "transition": {"enum": ["cut", "flash"]}
            }}},
          "overlay": {"type": "object", "required": ["text", "style"], "properties": {
            "text": {"type": "string"}, "style": {"enum": ["hook", "label", "stat", "none"]},
            "offset": {"type": "number", "minimum": 0}, "duration": {"type": "number", "exclusiveMinimum": 0}}}
        }
      }
    },
    "music": {"type": ["object", "null"], "properties": {
      "file": {"type": ["string", "null"]}, "volume": {"type": "number", "minimum": 0, "maximum": 0.4},
      "media_start": {"type": "number", "minimum": 0}}},
    "end_card": {"type": "object", "properties": {
      "duration": {"type": "number", "minimum": 1, "maximum": 3}, "text": {"type": "string"}, "subtext": {"type": "string"}}},
    "cover": {"type": "object", "required": ["headline"], "properties": {
      "asset": {"type": ["string", "null"]}, "frame_time": {"type": "number", "minimum": 0},
      "headline": {"type": "string", "maxLength": 48}, "subline": {"type": "string"}, "tag": {"type": "string"}}}
  }
}

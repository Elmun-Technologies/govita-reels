{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 *)",
      "Bash(python *)",
      "Bash(npx hyperframes *)",
      "Bash(node_modules/.bin/hyperframes *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(yt-dlp *)",
      "Bash(earshot *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(jq *)",
      "Bash(du *)",
      "Bash(bin/run-daily *)",
      "Bash(bin/install-skills *)",
      "Read(**)",
      "Write(runs/**)",
      "Write(knowledge/**)",
      "Write(bank/**)",
      "Edit(runs/**)",
      "Edit(knowledge/**)",
      "WebSearch",
      "WebFetch",
      "Skill"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Bash(cat .env*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(rm -rf /*)",
      "Bash(git push --force*)",
      "Bash(curl *api.telegram.org*)"
    ]
  },
  "env": {
    "PYTHONUNBUFFERED": "1",
    "HYPERFRAMES_SKIP_SKILLS": "1"
  }
}
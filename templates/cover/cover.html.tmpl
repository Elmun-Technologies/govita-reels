<!doctype html>
<html lang="uz">
  <head>
    <meta charset="UTF-8" />
    <style>
      {{FONT_FACES}}
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { width: 1080px; height: 1920px; overflow: hidden; background: {{COLOR_GROUND}}; }
      .bg { position: absolute; inset: 0; background: url('{{BG}}') center/cover no-repeat; }
      .shade { position: absolute; inset: 0;
        background: linear-gradient(180deg, rgba(0,0,0,.05) 0%, rgba(0,0,0,.10) 35%, rgba(0,0,0,.72) 78%, rgba(0,0,0,.85) 100%); }
      /* Instagram grid (4:5) markaziy zona: y = 285..1635 — asosiy matn shu oraliqda */
      .safe { position: absolute; left: 72px; right: 72px; top: 285px; height: 1350px;
              display: flex; flex-direction: column; justify-content: flex-end; gap: 28px; padding-bottom: 60px; }
      .tag { align-self: flex-start; font-family: {{FONT_DISPLAY}}; font-weight: 700; font-size: 40px;
             color: {{COLOR_ACCENT_INK}}; background: {{COLOR_ACCENT}}; padding: 12px 28px; border-radius: 999px; }
      .headline { font-family: {{FONT_DISPLAY}}; font-weight: 800; font-size: 118px; line-height: .98;
                  letter-spacing: -0.035em; color: {{COLOR_INK}}; text-wrap: balance; }
      .headline mark { background: {{COLOR_ACCENT}}; color: {{COLOR_ACCENT_INK}}; padding: 0 .1em; border-radius: .1em; }
      .sub { font-family: {{FONT_BODY}}; font-weight: 600; font-size: 50px; line-height: 1.15; color: {{COLOR_INK}}; opacity: .9; }
      .brand { position: absolute; right: 72px; top: 300px; font-family: {{FONT_DISPLAY}}; font-weight: 800;
               font-size: 44px; color: {{COLOR_INK}}; letter-spacing: -0.02em; text-shadow: 0 2px 12px rgba(0,0,0,.4); }
      .brand img { height: 64px; width: auto; }
    </style>
  </head>
  <body>
    <div class="bg"></div>
    <div class="shade"></div>
    <div class="brand">{{BRAND_MARK}}</div>
    <div class="safe">
      {{TAG}}
      <div class="headline">{{HEADLINE}}</div>
      <div class="sub">{{SUBLINE}}</div>
    </div>
  </body>
</html>

# ===== GoVita Reels Agency =====
# Nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring. .env git'ga TUSHMAYDI.
TZ=Asia/Tashkent

# --- Claude Code (Max obuna, API kaliti EMAS) ---
# Host kompyuterda:  claude setup-token   → chiqgan tokenni shu yerga
CLAUDE_CODE_OAUTH_TOKEN=

# --- ElevenLabs (ovoz) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Model o'zbek tilini language_code bilan qo'llasa: uz (aks holda bo'sh qoldiring)
ELEVENLABS_LANGUAGE_CODE=
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.8
ELEVENLABS_STYLE=0.25
ELEVENLABS_SPEED=1.05
# elevenlabs | silent (test: jim ovoz, kredit sarflamaydi)
TTS_PROVIDER=elevenlabs

# --- Tadqiqot va stok (bepul kalitlar) ---
YOUTUBE_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ixtiyoriy modullar (hozircha o'chiq) ---
ADOBE_STOCK_ENABLED=false
AIRSHOT_ENABLED=false

# --- Rejim va limitlar ---
DRY_RUN=0
REEL_MIN_SECONDS=40
REEL_MAX_SECONDS=90
MAX_COPY_LOOPS=2
MAX_EDIT_LOOPS=2
AGENT_TIMEOUT_MIN=40
PIPELINE_TIMEOUT_MIN=170
RENDER_WORKERS=auto
FINAL_CRF=20

# --- Docker resurslari (Mac qotib qolmasligi uchun) ---
DOCKER_CPUS=4
DOCKER_MEM=6g
